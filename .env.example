# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://alfizilham.my.id

# ---------- Database (Neon Postgres) ----------
# Pooled connection string (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string (no -pooler), used by prisma db push
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- Admin login (single account) ----------
ADMIN_USERNAME=alfzilham
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH_B64=
# Any random string of 32+ characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Object storage (Neon Object Storage or any S3 compatible bucket) ----------
S3_ENDPOINT=https://your-storage-endpoint
S3_REGION=us-east-2
S3_BUCKET=portfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Public base URL of the bucket. Leave empty to serve files through /api/files.
S3_PUBLIC_URL=

# ---------- Google Analytics 4 ----------
# Measurement ID for the tracking tag on the public site
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Property ID and a service account with Viewer access, for the dashboard charts
GA_PROPERTY_ID=412880365
GA_CLIENT_EMAIL=portfolio-analytics@your-project.iam.gserviceaccount.com
# Paste the private key with \n for line breaks
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- EmailJS ----------
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=
# Private key (Account > API keys). Turn on "Allow EmailJS API for non-browser applications" in Account > Security.
EMAILJS_PRIVATE_KEY=
# Auto-reply sent to the client after the contact form is submitted
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_auto01
# Your reply from the dashboard
EMAILJS_REPLY_TEMPLATE_ID=template_reply02
# Optional. Notification to you when a new message or feedback arrives
EMAILJS_NOTIFY_TEMPLATE_ID=
ADMIN_NOTIFY_EMAIL=alfizilham@gmail.com

# Security: set to true to enforce the Content-Security-Policy (it starts in report-only mode)
CSP_ENFORCE=false
