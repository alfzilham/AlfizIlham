# Normalisasi line ending (aman untuk Windows dan Vercel)
* text=auto eol=lf

# File teks
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.prisma text eol=lf
*.env.example text eol=lf

